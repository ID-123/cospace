    "format-all": "prettier . --write",
    "check-format": "prettier . --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@mikro-orm/core": "7.2.11",
    "@mikro-orm/postgresql": "7.2.11",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "next-intl": "^4.16.2",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.11",
    "@mikro-orm/migrations": "7.2.11",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.23.0"
