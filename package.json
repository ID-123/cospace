{
  "name": "cospace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "mikro-orm migration:up --config ./src/mikro-orm.config.ts",
